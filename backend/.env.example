# Copy to .env (never committed). Everything runs on your own PC: the modules and PostgreSQL.

# Your local PostgreSQL (16+). DB_PASSWORD = the password of the "postgres" user chosen when
# PostgreSQL was installed. The "matchup" database is created on the first start if it is missing.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=matchup

# Which module(s) may create/update their tables from their entities when they start:
# all, none, or a list (utilisateur,reservation). Your database is yours alone, so `all` is fine.
DB_SYNC=all

# Email through Gmail. SMTP_PASS = a Google "App password" (myaccount.google.com/apppasswords,
# needs 2-Step Verification), not the Gmail password. Without SMTP_PASS emails are printed in
# the terminal instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=
MAIL_FROM=MatchUp <your.address@gmail.com>
# Where the link of the confirmation email points (the utilisateur module on this PC).
PUBLIC_URL=http://localhost:3001

# Set to true to print the SQL queries.
DB_LOGGING=false
