# Copy to .env (never committed) and fill in DB_PASSWORD (ask the team).
# Everyone uses the ONE database on the server.
DB_HOST=92.222.36.107
DB_PORT=5432
DB_USER=matchup
DB_PASSWORD=
DB_NAME=matchup

# Which module(s) may create/alter tables from your entities when you start them.
# Put ONLY your own module here (e.g. DB_SYNC=reservation). The server uses DB_SYNC=all.
DB_SYNC=none

# Email (noreply@minolingo.online on OVH). Without SMTP_PASS emails are printed in the terminal.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=noreply@minolingo.online
SMTP_PASS=
MAIL_FROM=MatchUp <noreply@minolingo.online>
PUBLIC_URL=https://minolingo.online

# Set to true to print the SQL queries.
DB_LOGGING=false
