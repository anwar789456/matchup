{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/utilisateur",
  "sourceRoot": "apps/utilisateur/src",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "apps/utilisateur/tsconfig.app.json",
    "plugins": [{ "name": "@nestjs/swagger", "options": { "introspectComments": true } }]
  },
  "projects": {
    "utilisateur": {
      "type": "application",
      "root": "apps/utilisateur",
      "entryFile": "main",
      "sourceRoot": "apps/utilisateur/src",
      "compilerOptions": { "tsConfigPath": "apps/utilisateur/tsconfig.app.json" }
    },
    "reservation": {
      "type": "application",
      "root": "apps/reservation",
      "entryFile": "main",
      "sourceRoot": "apps/reservation/src",
      "compilerOptions": { "tsConfigPath": "apps/reservation/tsconfig.app.json" }
    },
    "paiement": {
      "type": "application",
      "root": "apps/paiement",
      "entryFile": "main",
      "sourceRoot": "apps/paiement/src",
      "compilerOptions": { "tsConfigPath": "apps/paiement/tsconfig.app.json" }
    },
    "tournois": {
      "type": "application",
      "root": "apps/tournois",
      "entryFile": "main",
      "sourceRoot": "apps/tournois/src",
      "compilerOptions": { "tsConfigPath": "apps/tournois/tsconfig.app.json" }
    },
    "entrainement": {
      "type": "application",
      "root": "apps/entrainement",
      "entryFile": "main",
      "sourceRoot": "apps/entrainement/src",
      "compilerOptions": { "tsConfigPath": "apps/entrainement/tsconfig.app.json" }
    },
    "forum": {
      "type": "application",
      "root": "apps/forum",
      "entryFile": "main",
      "sourceRoot": "apps/forum/src",
      "compilerOptions": { "tsConfigPath": "apps/forum/tsconfig.app.json" }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" }
    }
  }
}
